mixin _select-tree(records, parentId, level=1)
  each item in records
    - const prefix = Array(level+1).join('-- ')
    option(
      value=item.id
      selected=parentId==item.id?true:false
    ) #{prefix} #{item.title} 
    - if(item.children && item.children.length > 0)
      +_select-tree(item.children, parentId, level+1)

mixin select-tree(records, parentId='')
  +_select-tree(records, parentId)