extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(5000)

  h1(class='mb-4') Tạo tài khoản mới

  form(
    action=`${prefixAdmin}/accounts/create`
    id='form-create-product'
    method='POST'
    enctype='multipart/form-data'
  )

    div(class='form-group')
      label(for='fullName') Họ tên *
      input(
        type='text'
        class='form-control'
        id='fullName'
        name='fullName'
        required
      )

    div(class='form-group')
      label(for='email') Email *
      input(
        type='email'
        class='form-control'
        id='email'
        name='email'
        required
      )

    div(class='form-group')
      label(for='password') Mật khẩu *
      input(
        type='password'
        class='form-control'
        id='password'
        name='password'
        required
      )

    div(class='form-group')
      label(for='phone') Số điện thoại
      input(
        type='text'
        class='form-control'
        id='phone'
        name='phone'
      )

    div(
      class='form-group'
      upload-image
    )
      label(for='avatar' class='d-block') Avatar
      input(
        type='file'
        class='form-control-file d-block'
        id='avatar'
        name='avatar'
        accept='image/*'
        upload-image-input
      )
      div(class='image-preview-wrapper mt-3')
        img(
          src=''
          upload-image-preview
          class='image-preview'
        )
        span(
          class='close-image-preview'
          close-image-preview
        ) x
      
    div(class='form-group')
      label(for='role_id') Phân quyền
      select(
        id='role_id'
        name='role_id'
        class='form-control'
        required
      )
        option(value='' selected disabled hidden) -- Chọn --
        each item in roles
          option(value=item.id) #{item.title}

    div(class='form-group form-check form-check-inline')
      label(for='statusActive' class='form-check-label') Hoạt động
      input(
        type='radio'
        class='form-check-input'
        id='statusActive'
        name='status'
        value='active'
        checked
      )
    div(class='form-group form-check form-check-inline')
      label(for='statusInactive' class='form-check-label') Dừng hoạt động
      input(
        type='radio'
        class='form-check-input'
        id='statusInactive'
        name='status'
        value='inactive'
      )

    div(class='form-group')
      button(
        type='submit'
        class='btn btn-primary'
      ) Tạo mới