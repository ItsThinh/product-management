extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug

block main
  if role.permissions.includes('product-category_edit')
    +alert-error(5000)
    h1(class='mb-4') #{pageTitle}

    form(
      action=`${prefixAdmin}/product-categories/edit/${record.id}?_method=PATCH`
      method='POST'
      enctype='multipart/form-data'
    )
      div(class='form-group')
        label(for='title') Tiêu đề
        input(
          type='text'
          class='form-control'
          id='title'
          name='title'
          value=record.title
          required
        )
      div(class='form-group')
        label(for='parent_id') Danh mục cha
        select(
          class='form-control'
          id='parent_id'
          name='parent_id'
        )
          option(value='') -- Chọn danh mục cha --
          if (records) 
            +select-tree(records, record.parent_id)
            
      div(class='form-group')
        label(for='desc') Mô tả
        textarea(
          class='form-control textarea-mce'
          id='desc'
          name='description'
          rows='5'
        ) #{record.description}
      div(
        class='form-group'
        upload-image
      )
        label(for='thumbnail' class='d-block') Ảnh
        input(
          type='file'
          class='form-control-file d-block'
          id='thumbnail'
          name='thumbnail'
          accept='image/*'
          upload-image-input
        )
        div(class='image-preview-wrapper mt-3')
          img(
            src=record.thumbnail
            upload-image-preview
            class='image-preview'
          )
          span(
            class='close-image-preview'
            close-image-preview
          ) x
        
      div(class='form-group')
        label(for='position') Vị trí
        input(
          type='number'
          class='form-control'
          id='position'
          name='position'
          value=record.position
          min='1'
        )
      div(class='form-group form-check form-check-inline')
        label(for='statusActive' class='form-check-label') Hoạt động
        input(
          type='radio'
          class='form-check-input'
          id='statusActive'
          name='status'
          value='active'
          checked=record.status=='active'?true:false
        )
      div(class='form-group form-check form-check-inline')
        label(for='statusInactive' class='form-check-label') Dừng hoạt động
        input(
          type='radio'
          class='form-check-input'
          id='statusInactive'
          name='status'
          value='inactive'
          checked=record.status=='active'?false:true
        )
      div(class='form-group')
        button(
          type='submit'
          class='btn btn-primary'
        ) Cập nhật
