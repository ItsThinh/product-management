extends ../../layouts/default.pug

block main 
  if role.permissions.includes('role_create')
    h1 #{pageTitle}

    form(
      action=`${prefixAdmin}/roles/create`
      id='form-create-product'
      method='POST'
    )
      div(class='form-group')
        label(for='title' class='form-label') Tiêu đề
        input(
          type='text'
          class='form-control'
          id='title'
          name='title'
          required
        )
      div(class='form-group')
        label(for='description' class='form-label') Mô tả
        input(
          type='text'
          class='form-control'
          id='description'
          name='description'
        )
      div(class='form-group')
        button(type='submit' class='btn btn-primary') Tạo mới