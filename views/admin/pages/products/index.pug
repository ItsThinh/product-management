extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/formChangeMulti.pug
include ../../mixins/alert.pug
include ../../mixins/sort.pug
include ../../mixins/moment.pug

block main 
  if role.permissions.includes('product_view')
    +alert-success(5000)

    h1 DANH SÁCH SẢN PHẨM   
    .card.mb-3
      .card-header Bộ lọc và tìm kiếm
      .card-body
        .row
          .col-6
            +filter-status(filterStatus)
          .col-6 
            +search(keyword)

    .card.mb-3 
      .card-hearder Sắp xếp 
      .card-body 
        .row 
          .col-4 
            +sort()

    .card.mb-3
      .card-header Danh sách
        .card-body 
          .row 
            if role.permissions.includes('product_edit')
              .col-8
                +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
            if role.permissions.includes('product_create')
              .col-4 
                a(
                  href=`${prefixAdmin}/products/create`
                  class='btn btn-outline-success'
                ) + Thêm mới

          table(
            class='.table.table-hover.table-sm'
            checkbox-multi
          )
            thead 
              tr
                th
                  input(type='checkbox' name='checkall')
                th STT
                th Hình ảnh
                th Tiêu đề
                th Giá
                th Người tạo
                th Người cập nhật
                th Vị trí
                th Trạng thái
                th Hành động

            tbody
              each product, index in products
                tr 

                  td
                    input(
                      type='checkbox'
                      name='id'
                      value=product.id
                    )

                  td #{(paginationObject.currentPage - 1) * paginationObject.limit + index + 1}

                  td 
                    img(src=product.thumbnail, alt=product.title, width='100px', height='auto')

                  td #{product.title}

                  td #{product.price}$

                  td 
                    if (product.createdBy.account_id)
                      | #{product.createdByFullName}
                      br
                      +formatDate(product.createdBy.createdAt)
                      br
                      +formatTime(product.createdBy.createdAt)

                  td 
                    if product.lastUpdatedByFullName
                      | #{product.lastUpdatedByFullName}
                      br
                      +formatDate(product.lastUpdateTime)
                      br
                      +formatTime(product.lastUpdateTime)

                  td 
                    input(
                      type='number'
                      value=product.position 
                      style='width: 60px'
                      min='1'
                      name='position'
                    )

                  td 
                    if role.permissions.includes('product_edit')
                      if (product.status == 'active')
                        button(
                          type='button'
                          data-status=product.status
                          data-id=product.id
                          button-change-status
                          class='badge bg-success'
                        ) Hoạt động
                      else 
                        button(
                          type='button'
                          data-status=product.status
                          data-id=product.id
                          button-change-status
                          class='badge bg-secondary'
                        ) Dừng hoạt động

                  td 
                    if role.permissions.includes('product_edit')
                      a(
                        href=`${prefixAdmin}/products/edit/${product.id}`
                        class='btn btn-warning btn-sm'
                      ) Sửa
                    a(
                      href=`${prefixAdmin}/products/detail/${product.id}`
                      class='btn btn-info btn-sm'
                    ) Chi tiết
                    if role.permissions.includes('product_delete')
                      button(
                        class='btn btn-danger btn-sm ms-1'
                        button-delete
                        data-id=product.id
                      ) Xóa

    +pagination(paginationObject)

    form(
      action=''
      method='POST'
      id='form-change-status'
      data-path=`${prefixAdmin}/products/change-status`
    )
    //- Form chỉ hỗ trợ 2 phương thức là GET và POST, muốn xử dụng
    //- các phương thức khác thì phải cài thêm thư viện.
    //- Thư viện sẽ được dùng là method-override

    form(
      action=''
      method='POST'
      id='form-delete-item'
      data-path=`${prefixAdmin}/products/delete`
    )
    
    script(src='/admin/js/product.js')