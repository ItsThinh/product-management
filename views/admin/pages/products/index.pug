extends ../../layouts/default.pug
block main 
  h1 DANH SÁCH SẢN PHẨM 
  
  table
    thead 
      tr
        th STT
        th Hình ảnh
        th Tiêu đề
        th Giá
        th Trạng thái
        th Hành động

    tbody
      each product, index in products
        tr 
          td #{index + 1}
          td 
            img(src=product.thumbnail, alt=product.title, width='100px', height='auto')
          td #{product.title}
          td #{product.price}$
          td 
            if (product.status == 'active')
              a(href='#', class='badge bg-success') Hoạt động
            else 
              a(href='#', class='badge bg-secondary') Dừng hoạt động
          td 
            button(class='btn btn-warning btn-sm') Sửa
            button(class='btn btn-danger btn-sm ml-1') Xóa