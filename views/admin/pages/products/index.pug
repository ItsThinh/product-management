extends ../../layouts/default.pug
include ../../mixins/filterStatus.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug

block main 
  h1 DANH SÁCH SẢN PHẨM 
  
  .card.mb-3
    .card-header Bộ lọc và tìm kiếm
    .card-body
      .row
        .col-6
          +filter-status(filterStatus)
        .col-6 
          +search(keyword)

  .card.mb-3
    .card-header Danh sách
    .card-body
      table
        thead 
          tr
            th STT
            th Hình ảnh
            th Tiêu đề
            th Giá
            th Trạng thái
            th Hành động

        tbody
          each product, index in products
            tr 
              //- td #{index + 1}
              td #{product.position}
              td 
                img(src=product.thumbnail, alt=product.title, width='100px', height='auto')
              td #{product.title}
              td #{product.price}$
              td 
                if (product.status == 'active')
                  button(
                    type='button'
                    data-status=product.status
                    data-id=product.id
                    button-change-status
                    class='badge bg-success'
                  ) Hoạt động
                else 
                  button(
                    type='button'
                    data-status=product.status
                    data-id=product.id
                    button-change-status
                    class='badge bg-secondary'
                  ) Dừng hoạt động
              td 
                button(class='btn btn-warning btn-sm') Sửa
                button(class='btn btn-danger btn-sm ms-1') Xóa

  +pagination(paginationObject)

  form(
    action=''
    method='POST'
    id='form-change-status'
    data-path=`${prefixAdmin}/products/change-status`
  )
  //- Form chỉ hỗ trợ 2 phương thức là GET và POST, muốn xử dụng
  //- các phương thức khác thì phải cài thêm thư viện.
  //- Thư viện sẽ được dùng là method-override
  
  script(src='/admin/js/product.js')