extends ../../layouts/default.pug

block main
  if (product.title)
    h1.mb-4 #{product.title}
  if (product.description)
    div.mb-4 #{product.description}
  if (product.price)
    div.mb-4 Giá: <b>#{product.price}$</b>
  if (product.discountPercentage)
    div.mb-4 Giảm giá: <b>#{product.discountPercentage}%</b>
  if (product.stock)
    div.mb-4 Số lượng: <b>#{product.stock}</b>
  if (product.thumbnail)
    div.mb-4
      image(src=product.thumbnail style='width: 200px')
  if (product.status)
    div.mb-4 Trạng thái: <b>#{product.status}</b>
  if (product.position)
    div.mb-4 Vị trí: <b>#{product.position}</b>
  a(
    href=`${prefixAdmin}/products/edit/${product.id}`
    class='btn btn-warning btn-sm'
  ) Chỉnh sửa