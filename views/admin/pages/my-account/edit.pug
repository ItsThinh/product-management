extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)

  h1(class='mb-4') Chỉnh sửa tài khoản

  form(
      action=`${prefixAdmin}/my-account/edit/?_method=PATCH`
      id='form-create-product'
      method='POST'
      enctype='multipart/form-data'
  )
    div(class='form-group')
    label(for='fullName') Họ tên *
    input(
        type='text'
        class='form-control'
        id='fullName'
        name='fullName'
        value=user.fullName
        required
    )

    div(class='form-group')
    label(for='email') Email *
    input(
        type='text'
        class='form-control'
        id='email'
        name='email'
        value=user.email
        required
    )

    div(class='form-group')
    label(for='password') Mật khẩu *
    input(
        type='password'
        class='form-control'
        id='password'
        name='password'
    )

    div(class='form-group')
    label(for='phone') Số điện thoại
    input(
        type='text'
        class='form-control'
        id='phone'
        name='phone'
        value=user.phone
    )

    div(
      class='form-group'
      upload-image
    )
      label(for='avatar' class='d-block') Avatar
      input(
          type='file'
          class='form-control-file d-block'
          id='avatar'
          name='avatar'
          accept='image/*'
          upload-image-input
      )
      div(class='image-preview-wrapper mt-3')
        img(
          src=user.avatar
          upload-image-preview
          class='image-preview'
        )
        span(
          class='close-image-preview'
          close-image-preview
        ) x
    
    div(class='form-group')
    button(
        type='submit'
        class='btn btn-primary'
    ) Cập nhật
  
  script(src='../../../../public/admin/js/my-account.js')