extends ../../layouts/default.pug

block main
  .container.py-5
    .row.justify-content-center
      .col-md-5.text-center
        h3 Xác nhận OTP
        p.text-muted Mã đã gửi đến: #{email}

        form(action="/user/password/otp" method="POST")
          input(
            type='hidden'
            name='email'
            value=email
          )
          .mb-3
            input.form-control.form-control-lg.text-center.mx-auto(
              type="text"
              name="otp"
              maxlength="6"
              inputmode="numeric"
              pattern="[0-9]*"
              style="letter-spacing: 10px; font-size: 2rem; width: 200px;"
              required
            )
          
          button.btn.btn-primary.px-5(type="submit") Xác nhận
        
        .mt-3
          form(action="/user/password/forgot" method="POST")
            input(
              type='hidden'
              name='email'
              value=email
            )
            span.small.text-muted Không nhận được mã? 
            button.btn.btn-link.btn-sm.p-0.align-baseline(type="submit" style="text-decoration: none;") Gửi lại mã