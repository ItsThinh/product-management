extends ../../layouts/default.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow-sm.border-0
          .card-body.p-4.p-sm-5
            h2.text-center.fw-bold.mb-3 Quên mật khẩu
            p.text-center.text-muted.mb-4 
              | Nhập địa chỉ email của bạn và chúng tôi sẽ gửi hướng dẫn để lấy lại mật khẩu.

            form(action="/user/password/forgot" method="POST")
              .mb-4
                label.form-label.fw-bold(for="email") Địa chỉ Email
                input#email.form-control.form-control-lg(
                  type="email" 
                  name="email" 
                  placeholder="name@example.com"
                  required
                )
              
              .d-grid.mb-3
                button.btn.btn-primary.btn-lg.fw-bold(type="submit") 
                  | Gửi yêu cầu
            
            .text-center.mt-4
              a.text-decoration-none.small(href="/user/login") 
                i.fa-solid.fa-arrow-left.me-2
                | Quay lại đăng nhập