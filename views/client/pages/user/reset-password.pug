extends ../../layouts/default.pug

block main
  .container.py-5
    .row.justify-content-center
      .col-md-5
        .card.shadow-sm
          .card-body
            h3.text-center.mb-4 Đổi mật khẩu mới
            form(action="/user/password/reset" method="POST")
              .mb-3
                label.form-label(for="password") Mật khẩu mới
                input#password.form-control(
                  type="password"
                  name="password"
                  required
                )
              .mb-3
                label.form-label(for="confirmPassword") Xác nhận mật khẩu
                input#confirmPassword.form-control(
                  type="password"
                  name="confirmPassword"
                  required
                )
              .d-grid
                button.btn.btn-primary(type="submit") Đổi mật khẩu
