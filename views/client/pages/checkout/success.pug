extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-5
    .row.justify-content-center
      .col-md-9
        .card.shadow-sm.border-0.p-4
          //- Header Thành công
          .text-center.mb-4
            div.mb-3
              i.fa-solid.fa-circle-check.fa-5x.text-success
            h2.fw-bold Đặt hàng thành công!
            p.text-muted Mã đơn hàng: 
              span.fw-bold.text-primary ##{order._id}

          .row
            //- Cột trái: Thông tin người nhận
            .col-md-5.border-end
              h5.mb-3.fw-bold.border-bottom.pb-2 <i class="fa-solid fa-user-check me-2"></i>Thông tin nhận hàng
              .mb-3
                .text-muted.small Họ tên
                .fw-bold #{order.userInfo.fullName}
              .mb-3
                .text-muted.small Số điện thoại
                .fw-bold #{order.userInfo.phone}
              .mb-3
                .text-muted.small Địa chỉ nhận hàng
                .fw-bold #{order.userInfo.address}
              
              if (order.note)
                .p-2.bg-light.rounded
                  .text-muted.small Ghi chú
                  .fst-italic "#{order.note}"

            //- Cột phải: Danh sách sản phẩm (Dàn hàng dọc)
            .col-md-7.ps-md-4
              h5.mb-3.fw-bold.border-bottom.pb-2 <i class="fa-solid fa-box-open me-2"></i>Chi tiết sản phẩm
              
              .order-items-list
                each item in order.products
                  .d-flex.mb-3.pb-3.border-bottom.align-items-start
                    //- Ảnh sản phẩm
                    img(
                      src=item.thumbnail 
                      alt=item.title 
                      width="80px" 
                      height="80px"
                      class="rounded shadow-sm object-fit-cover"
                    )
                    
                    //- Thông tin chi tiết dàn theo chiều dọc
                    .ms-3.flex-grow-1
                      .fw-bold.text-primary.mb-1 #{item.title}
                      
                      .d-flex.justify-content-between.align-items-center
                        div
                          span.text-muted.small Số lượng: 
                          span.fw-bold #{item.quantity}
                        div.text-end
                          //- Giá cũ gạch đi (hiển thị phía trên giá mới)
                          if (item.price > item.newPrice)
                            div.text-muted.small.text-decoration-line-through $#{item.price}
                          //- Giá mới nổi bật
                          div.text-danger.fw-bold $#{item.newPrice}
                      
                      .text-end.mt-1
                        span.text-muted.small Thành tiền: 
                        span.fw-bold.text-dark $#{item.newPrice * item.quantity}
              
              //- Tổng thanh toán cuối cùng
              .bg-light.p-3.rounded.mt-3
                .d-flex.justify-content-between.align-items-center
                  span.fw-bold.fs-5 Tổng thanh toán:
                  span.fs-3.fw-bold.text-danger $#{order.total}

          //- Nút hành động
          .text-center.mt-5.pt-3.border-top
            a.btn.btn-primary.btn-lg.me-md-2.mb-2.mb-md-0.px-4(href="/products") 
              i.fa-solid.fa-cart-shopping.me-2
              | Tiếp tục mua sắm
            a.btn.btn-outline-secondary.btn-lg.px-4(href="/") 
              i.fa-solid.fa-house.me-2
              | Về trang chủ