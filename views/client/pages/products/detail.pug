extends ../../layouts/default.pug

block main
  
  .container.my-5
    .row.g-4

      //- Hình ảnh sản phẩm
      .col-lg-6
        .border.rounded.overflow-hidden.shadow-sm.bg-white
          if (product.thumbnail)
            img(
              src=product.thumbnail
              alt=product.title
              class="img-fluid"
              style="max-height:450px; object-fit:contain; width:100%"
            )
          else
            .d-flex.align-items-center.justify-content-center.bg-light(
              style="height:400px"
            )
              span.text-muted Không có hình ảnh

      //- Thông tin sản phẩm
      .col-lg-6

        if (product.title)
          h1.mb-3.text-primary #{product.title}

        if (product.category)
          .mb-3
            span.badge.bg-info.p-2
              | Danh mục: #{product.category.title}

        //- Box giá
        .p-4.bg-light.rounded.mb-4

          if (product.finalPrice)
            .h2.text-danger.fw-bold.mb-2
              | $#{product.finalPrice}

          if (product.discountPercentage)
            .mb-2
              span.text-muted.text-decoration-line-through.me-2
                | Giá gốc: $#{product.price}

              span.badge.bg-danger
                | -#{product.discountPercentage}%

        //- Trạng thái kho
        if (product.stock && product.stock > 0)
          .mb-4
            span.text-success.fw-bold
              | ● Còn hàng
            span.text-muted.ms-2
              | (Số lượng: #{product.stock})
        else
          .mb-4
            span.text-danger.fw-bold
              | ● Hết hàng

        //- Form thêm vào giỏ
        form(
          action=`/cart/add/${product.id}`
          method="POST"
          class="border rounded p-4 bg-white shadow-sm"
        )

          .d-flex.align-items-center.mb-3
            label.me-3.fw-bold.mb-0 Số lượng

            input.form-control(
              type="number"
              name="quantity"
              value="1"
              min="1"
              max=product.stock
              style="width:100px"
            )

          button.btn.btn-success.btn-lg.w-100(
            type="submit"
            disabled=(product.stock <= 0)
          )
            i.fa.fa-shopping-cart.me-2
            | Thêm vào giỏ hàng


    //- Mô tả sản phẩm
    if (product.description)
      hr.my-5

      .product-description
        h3.mb-3 Thông tin chi tiết

        .border.rounded.p-4.bg-white.shadow-sm
          != product.description
