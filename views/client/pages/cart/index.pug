extends ../../layouts/default.pug

block main 
  .container.my-5
    .row
      .col-12
        h1.mb-4 Giỏ hàng của bạn
        
        if (products && products.length > 0)
          .table-responsive
            table.table.table-hover.align-middle
              thead.table-light
                tr
                  th(scope='col') STT
                  th(scope='col') Ảnh
                  th(scope='col') Tên sản phẩm
                  th(scope='col') Giá
                  th(scope='col') Số lượng
                  th(scope='col') Tổng tiền
                  th(scope='col', class="text-center") Hành động
              tbody
                each product, index in products
                  tr
                    td #{index + 1}
                    td
                      img(
                        src=product.thumbnail
                        alt=product.title
                        class="img-thumbnail" 
                        style="width: 80px;"
                      )
                    td
                      a(href=`/products/detail/${product.slug}` class="text-decoration-none fw-bold") #{product.title}
                    td $#{product.newPrice}
                    td
                      input(
                        quantity-input
                        type="number" 
                        value=product.quantity 
                        min="1" 
                        class="form-control" 
                        style="width: 70px;"
                        product-id=product._id
                      )
                    td.fw-bold $#{product.total}
                    td.text-center
                      a(
                        href=`/cart/delete/${product._id}`
                        class='btn btn-outline-danger btn-sm'
                      )
                        i.fa-solid.fa-trash.me-1
                        | Xóa

          hr.my-4
          .row.justify-content-end
            .col-md-4
              .card.shadow-sm
                .card-body
                  .d-flex.justify-content-between.mb-3
                    span.fw-bold.fs-5 Tổng cộng:
                    span.fw-bold.fs-5.text-danger $#{total}
                  .d-grid.gap-2
                    a.btn.btn-success.btn-lg(href='/checkout') Thanh toán ngay
                    a.btn.btn-outline-secondary(href="/products") Tiếp tục mua hàng
        
        else 
          .text-center.py-5
            .mb-3
              i.fa-solid.fa-cart-shopping.fa-4x.text-muted
            p.fs-5 Giỏ hàng của bạn đang trống.
            a.btn.btn-primary(href="/products") Quay lại mua sắm ngay

  script(src='client/js/cart.js')