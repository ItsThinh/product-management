extends ../../layouts/default.pug

block main
  .container.my-3
    style.
      /* Khung bao ngoài cùng để giới hạn chiều cao */
      .chat-wrapper {
        display: flex;
        flex-direction: column;
        height: 80vh; /* Giới hạn khung chat chiếm 80% chiều cao màn hình */
        border: 1px solid #ddd;
        border-radius: 8px;
        background: white;
      }
      
      /* Vùng chứa tin nhắn có thanh cuộn */
      #chat-container {
        flex: 1;
        overflow-y: auto; 
        padding: 20px;
        background: #f4f7f6;
        display: flex;
        flex-direction: column;
      }

      .message {
        margin-bottom: 10px;
        padding: 8px 15px;
        border-radius: 15px;
        max-width: 70%;
        word-wrap: break-word;
        position: relative;
      }

      .sent {
        background: #007bff;
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 2px;
      }

      .received {
        background: #e9e9eb;
        color: black;
        align-self: flex-start;
        border-bottom-left-radius: 2px;
      }

      #input-area {
        display: flex;
        padding: 15px;
        background: white;
        border-top: 1px solid #ddd;
      }

      #input-area input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 20px;
        outline: none;
      }

      #input-area button {
        margin-left: 10px;
        padding: 0 20px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 20px;
        cursor: pointer;
      }
      
      /* emoji-picker-element */
      .tooltip {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }

      .tooltip.shown {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
      }

      /* Typing Indicator Style */
      .inner-list-typing {
        position: relative;
      }
      .box-typing {
        position: relative;
        align-self: flex-start;
        margin-bottom: 10px;
      }
      .inner-dots {
        display: inline-flex;
        align-items: center;
        background: #e9e9eb;
        padding: 10px 15px;
        border-radius: 15px;
        border-bottom-left-radius: 2px;
      }
      .inner-dots span {
        height: 8px;
        width: 8px;
        margin: 0 2px;
        background-color: #a0a0a0;
        border-radius: 50%;
        display: inline-block;
        animation: dot-blink 1.4s infinite both;
      }
      .inner-dots span:nth-child(2) { animation-delay: 0.2s; }
      .inner-dots span:nth-child(3) { animation-delay: 0.4s; }
      @keyframes dot-blink {
        0% { opacity: 0.2; }
        20% { opacity: 1; }
        100% { opacity: 0.2; }
      }

      /* Image Styles */
      .inner-images {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 5px;
      }
      .sent .inner-images { justify-content: flex-end; }
      .received .inner-images { justify-content: flex-start; }
      .inner-images img { width: 80px; height: 80px; object-fit: cover; border-radius: 5px; }

      /* Upload Preview */
      .chat-wrapper .inner-preview-images .label-container {
        display: none;
      }

      .chat-wrapper .inner-preview-images .input-container {
        display: none;
      }

      .chat-wrapper .inner-preview-images .image-preview {
        height: auto;
        padding: 0;
        border-radius: 0;
      }

      .chat-wrapper .inner-preview-images .image-preview-item {
        width: 90px;
        background-size: contain;
      }

    h2(style="text-align: center;") Phòng Chat Trực Tuyến
    
    .chat-wrapper(my-id=user.id)
      #chat-container
        each chat in chats
          div(class=(chat.user_id == user.id ? 'message sent' : 'message received'))
            if (chat.user_id != user.id)
              strong(style="display:block; font-size: 12px; margin-bottom: 3px;") #{chat.user.fullName}
            if (chat.content)
              span #{chat.content}
            if (chat.images)
              .inner-images 
                each image in chat.images
                  img(src=image)
        div.inner-list-typing

      .inner-preview-images 
        div(class="custom-file-container", data-upload-id="upload-images")

      form#input-area(action="")
        input(type="text", name='content', placeholder="Nhập tin nhắn...", autocomplete="off")
        span.button-icon.btn.btn-light.mx-2: i.fa-solid.fa-face-smile
        label(
          class='button-icon btn btn-light mx-2'
          for='file-upload-with-preview-upload-images'
        )
          i.fa-solid.fa-image
        
        button(type="submit") Gửi
  div(class='tooltip', role='tooltip')
    emoji-picker