extends ../../layouts/default.pug

block main
  .container.my-3
    style.
      /* Khung bao ngoài cùng để giới hạn chiều cao */
      .chat-wrapper {
        display: flex;
        flex-direction: column;
        height: 80vh; /* Giới hạn khung chat chiếm 80% chiều cao màn hình */
        border: 1px solid #ddd;
        border-radius: 8px;
        background: white;
      }
      
      /* Vùng chứa tin nhắn có thanh cuộn */
      #chat-container {
        flex: 1;
        overflow-y: auto; 
        padding: 20px;
        background: #f4f7f6;
        display: flex;
        flex-direction: column;
      }

      .message {
        margin-bottom: 10px;
        padding: 8px 15px;
        border-radius: 15px;
        max-width: 70%;
        word-wrap: break-word;
        position: relative;
      }

      .sent {
        background: #007bff;
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 2px;
      }

      .received {
        background: #e9e9eb;
        color: black;
        align-self: flex-start;
        border-bottom-left-radius: 2px;
      }

      #input-area {
        display: flex;
        padding: 15px;
        background: white;
        border-top: 1px solid #ddd;
      }

      #input-area input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 20px;
        outline: none;
      }

      #input-area button {
        margin-left: 10px;
        padding: 0 20px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 20px;
        cursor: pointer;
      }

    h2(style="text-align: center;") Phòng Chat Trực Tuyến
    
    .chat-wrapper(my-id=user.id)
      #chat-container
        each chat in chats
          if (chat.user_id != user.id)
            .message.received
              strong(style="display:block; font-size: 12px; margin-bottom: 3px;") #{chat.user.fullName}
              span #{chat.content}
          else
            .message.sent
              span #{chat.content}

      form#input-area(action="")
        input(type="text", name='content', placeholder="Nhập tin nhắn...", autocomplete="off")
        button(type="submit") Gửi