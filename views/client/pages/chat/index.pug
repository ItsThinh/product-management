extends ../../layouts/default.pug

block main
  .container.my-3
    style.
      body { font-family: sans-serif; display: flex; flex-direction: column; height: 100vh; margin: 0; }
      #chat-container { flex: 1; overflow-y: auto; padding: 20px; background: #f9f9f9; }
      .message { margin-bottom: 15px; padding: 10px; border-radius: 8px; max-width: 70%; }
      .sent { background: #007bff; color: white; align-self: flex-end; margin-left: auto; }
      .received { background: #e9e9eb; color: black; }
      #input-area { display: flex; padding: 10px; border-top: 1px solid #ccc; }
      input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 4px; }
      button { padding: 10px 20px; margin-left: 10px; background: #28a745; color: white; border: none; cursor: pointer; }

    h2(style="text-align: center;") Phòng Chat Trực Tuyến

    #chat-container
      .message.received
        strong Admin: 
        span Chào mừng bạn đến với khung chat!
      .message.sent
        strong Bạn: 
        span Xin chào, tôi có thể giúp gì không?

    form#input-area(action="#")
      input(type="text", placeholder="Nhập tin nhắn...", required)
      button(type="submit") Gửi