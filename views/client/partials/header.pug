include ../mixins/sub-menu.pug

//- Thay py-3 thành py-2 để Header mỏng lại
header.header.py-2.border-bottom.bg-white
  .container
    .row.align-items-center
      //- 1. Logo (Giảm nhẹ chiều cao)
      .col-auto
        .inner-logo
          a(href="/")
            img(src="/client/images/logo.svg", alt="logo", style="height: 30px;")

      //- 2. Thanh tìm kiếm (Làm gọn lại)
      .col.mx-4
        form(action=`/search` method='GET')
          .input-group.input-group-sm
            input.form-control(
              type='text'
              placeholder='Tìm kiếm...'
              name='keyword'
              value=keyword
              style="border-radius: 20px 0 0 20px;"
            )
            button.btn.btn-primary(
              type='submit'
              style="border-radius: 0 20px 20px 0;"
            ) Tìm

      //- 3. Menu (Sát lại gần nhau hơn)
      .col-auto
        .inner-menu
          //- Giảm gap-4 xuống gap-3 để menu trông gọn gàng
          ul.d-flex.align-items-center.list-unstyled.mb-0.gap-3
            li.sub-menu.position-relative
              a.text-decoration-none.custom-link.small(href="/products") Sản phẩm
              +sub-menu(layoutProductCategory, '/products')
            
            li
              a.text-decoration-none.custom-link.small(href="/cart") 
                | Giỏ hàng (#{miniCart ? miniCart.totalQuantity : 0})
            
            li
              a.text-decoration-none.custom-link.small(href="/user/register") Đăng ký