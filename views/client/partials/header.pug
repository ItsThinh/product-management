include ../mixins/sub-menu.pug

//- Thẻ <header> với class="header". Các thẻ bên dưới chỉ ghi tên class mà không ghi thẻ thì mặc định là thẻ <div>
header.header
  //- Cách trái và phải 1 đoạn
  .container
    //- Chia hàng và chia cột
    .row.align-items-center
      //- Chiếm 3 cột
      .col-3
        .inner-logo
          a(href="/")
            img(src="/client/images/logo.svg", alt="logo")
      //- Chiếm 9 cột
      .col-9
        .inner-menu
          ul 
            li
              a(href="/") Trang chủ
            li(class='sub-menu')
              a(href="/products") Sản phẩm
              +sub-menu(layoutProductCategory, '/products')