include ../mixins/sub-menu.pug

//- Thẻ <header> với class="header". Các thẻ bên dưới chỉ ghi tên class mà không ghi thẻ thì mặc định là thẻ <div>
header.header
  //- Cách trái và phải 1 đoạn
  .container
    //- Chia hàng và chia cột
    .row.align-items-center
      //- Chiếm 3 cột
      .col-3
        .inner-logo
          a(href="/")
            img(src="/client/images/logo.svg", alt="logo")

      .col-5 
        form(
          action=`/search`
          method='GET'
        )
          div(class='form-group d-flex mb-0')
            input(
              class='form-control'
              type='text'
              placeholder='Nhập từ khóa...'
              name='keyword'
            )
            button(
              class='btn btn-primary'
              type='submit'
            ) Tìm

      //- Chiếm 4 cột
      .col-4
        .inner-menu
          ul 
            li
              a(href="/") Trang chủ
            li(class='sub-menu')
              a(href="/products") Sản phẩm
              +sub-menu(layoutProductCategory, '/products')