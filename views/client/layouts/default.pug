include ../mixins/alert.pug

doctype html 
html 
  head 
    title #{pageTitle}
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css")
    
    //- file-upload-with-preview
    link(rel="stylesheet", href="https://unpkg.com/file-upload-with-preview/dist/style.css")

    //- viewerjs
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.css")

    link(rel="stylesheet", href="/client/css/style.css")
  body

    .main-content(style="margin-top: 20px;") 
      +alert-success(5000)
      +alert-error(5000)

    include ../partials/header.pug

    block main
    
    include ../partials/footer.pug

    script(src="/client/js/script.js")
    script(src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js")

    //- viewerjs
    script(src='https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.js')

    //- file-upload-with-preview
    //- Nhúng trước file chat.js vì chat.js cần file này để load thư viện
    script(src="https://unpkg.com/file-upload-with-preview/dist/index.iife.js")

    script(src='/socket.io/socket.io.js')

    //- Cần load script này trước vì nó khởi tạo biến socket trong scope
    script(src='/client/js/socket.js')
    //- Load script này sau vì nó có dùng socket đã được khởi tạo
    script(type='module', src='/client/js/chat.js')

    //- emoji-picker-element
    script(type="module", src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js")
    //- End emoji-picker-element

    //- Fontawesome
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    